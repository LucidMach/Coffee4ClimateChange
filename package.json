{
  "name": "nile-coffee-loop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:reset": "node --experimental-strip-types scripts/reset-demo.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "backend:check": "node scripts/check-backend.mjs",
    "format": "prettier --write src e2e docs scripts *.ts *.mjs *.json README.md",
    "format:check": "prettier --check src e2e docs scripts *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "agent-browser": "^0.21.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
