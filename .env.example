# Local demo only. SQLite cannot be used as persistent storage on Vercel.
NILE_STORAGE=sqlite
# Optional: absolute local database path; defaults to .nile/demo.sqlite
# NILE_DB_PATH=
# Server-only. Never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=
# Set a model available to your API project. No API requests run without both values.
OPENAI_MODEL=gpt-4.1-mini
# Cloud launch requires Supabase auth, storage adapter and reviewed RLS policies.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Coffee quality model service (ml_service/). Server-side only.
COFFEE_ML_API_URL=http://127.0.0.1:5001
# Proxy timeout in ms; free hosting tiers can take ~50 s to wake.
COFFEE_ML_TIMEOUT_MS=45000

# Public judge sandbox: private per-browser snapshots, live API spending disabled.
# NILE_JUDGE_DEMO=1
# NILE_DEMO_SECRET=<at least 32 random characters, server-only>
# BLOB_READ_WRITE_TOKEN=<private Vercel Blob store token, server-only>
