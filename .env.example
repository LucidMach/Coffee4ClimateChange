# Local demo only. SQLite cannot be used as persistent storage on Vercel.
NILE_STORAGE=sqlite
# Optional: absolute local database path; defaults to .nile/demo.sqlite
# NILE_DB_PATH=
# Server-only. Never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=
# Set a model available to your API project. No API requests run without both values.
OPENAI_MODEL=
# Cloud launch requires Supabase auth, storage adapter and reviewed RLS policies.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
